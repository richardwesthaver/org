;;; skelfile --- CC/org skelfile -*- mode: skel; -*-
:name org
:author ("Richard Westhaver" . "ellis@rwest.io")
:version "0.1.0"
:license "MPL"
:description "CC Org Files"
:tags ("org" "docs" "notes" "blog" "meta" "plan" "archive" "notes" "graph")
:vc (:hg "https://vc.compiler.company/org"
     (cb (:git "ssh://git@codeberg.org/c-c/org"))
     (gh (:git "ssh://git@github.com/richardwesthaver/org")))
:bind
((cdn-home :env "/opt/stash/data/web/cdn")
 (org-deploy-ssh-key :env "~/.ssh/ellis_aws.pem")
 (org-deploy-user :env "fedora")
 (org-deploy-host :env "compiler.company")
 (org-deploy-path :env "/srv/http/compiler.company/"))
:rules
((build ()
  (with-emacs (e)
   (org-babel-lob-ingest company-babel-file)
   (org-graph-init)
   (mapc 
    (lambda (f)
     (org-with-file-buffer f
      (org-babel-execute-buffer)
      (save-buffer)))
    (flatten
     (mapcar (lambda (x) (directory-files-recursively x "\\(readme\\|index\\)[.]org$"))
      (list "docs" "graph" "plan" "blog" "notes" "archive"))))))
 (docs ()
  (:update ()
   (with-emacs (e)
    (org-babel-lob-ingest company-babel-file)
    (mapc (lambda (f)
           (org-with-file-buffer f
            (org-babel-execute-buffer)
            (save-buffer)))
    (flatten
     (cons "docs/core/ref.org"
      (mapcar (lambda (x) (directory-files-recursively x "[.]org$"))
       (list "docs"))))))))
 (css ()
  (css:compile-css-file "clean.css.lisp" "clean.css"))
 (publish ()
  (with-emacs (e)
   (org-babel-lob-ingest company-babel-file)
   (load-library "publish")
   (publish t t)))
 (deploy ()
  #$scp -i $ORG_DEPLOY_SSH_KEY -r /tmp/www/* "$ORG_DEPLOY_USER@$ORG_DEPLOY_HOST:$ORG_DEPLOY_PATH"$#
  (println :ok))
 (upstream ()
  (labels ((bump (name)
            (let ((path (directory-path (merge-pathnames name "/tmp/"))))
             (probe-delete-directory path :recursive t)
             (vc-export 
              (make-instance 'hg-repo 
               :path (if (equal name "org") 
                      (current-directory) 
                      (probe-directory name)))
              path)
             (with-repo (r :path path :type :git)
              (vc-remote r :add :name "cb" :url (format nil "ssh://git@codeberg.org/c-c/~A" name))
              (vc-remote r :add :name "gh" :url (format nil "ssh://git@github.com/richardwesthaver/~A" name))
              (when (equal name "org")
               (vc-update r)
               (vc-submodule r :add :url "https://github.com/richardwesthaver/graph")
               (vc-submodule r :add :url "https://github.com/richardwesthaver/notes")
               (vc-submodule r :add :url "https://github.com/richardwesthaver/meta")
               (vc-submodule r :add :url "https://github.com/richardwesthaver/plan")
               (vc-submodule r :add :url "https://github.com/richardwesthaver/blog")
               (vc-submodule r :add :url "https://github.com/richardwesthaver/docs")
               (vc-add r ".gitmodules")
               (vc-commit r "gitmodules"))
              (vc-push r :set-upstream t :remote "cb" :branch "default" :force t)
              (vc-push r :remote "gh" :branch "default" :force t))))
           (bump* (&rest subrepos)
            (dolist (s subrepos)
             (bump s))))
   (bump* "graph" "meta" "plan" "docs" "blog" "notes" "org")))
 (dist-repos ()
  (vc-bundle (sk-vc *skel-project*) "/opt/store/packy/vc/org.hg")
  (mapc
   (lambda (x)
    (vc-bundle
     (make-repo (probe-file (directory-path x)))
     (merge-pathnames (format nil "vc/~A.hg" x) "/opt/store/packy/")))
   '("graph" "plan" "docs" "blog" "meta" "notes" "archive")))
 (dist-source ()
  (with-directory ".."
   #$tar --exclude='*/.hg' --exclude='#*#' -I 'zstd' -cf org/org.tar.zst org/*$#)))
